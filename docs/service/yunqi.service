[Unit]
Description=Yunqi API Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/yunqi
ExecStart=/opt/yunqi/yunqi-linux-amd64
# 使用 --logdir none 禁用日志文件写入，完全交由 journald 管理日志
# ExecStart=/opt/yunqi/yunqi-linux-amd64 --logdir none
EnvironmentFile=/opt/yunqi/.env
Restart=always
RestartSec=5
User=yunqi
Group=yunqi

[Install]
WantedBy=multi-user.target
